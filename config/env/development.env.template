# Configuracion comun
CHROMIUM_DIR=C:\Users\tu-usuario\AppData\Local\Chromium\Application\chrome.exe
APP_NAME=Chat Pack Bot Dev
MAPS_API=
SEE_BUS_BASE_URL=https://micronauta2.dnsalias.net/usuario/app/yaviene/

# Descarga automatica de links publicos de Instagram, TikTok y X/Twitter
SOCIAL_DOWNLOAD_ENABLED=true
SOCIAL_DOWNLOAD_GROUPS_ENABLED=false
SOCIAL_DOWNLOAD_MAX_FILE_MB=100
SOCIAL_DOWNLOAD_TIMEOUT_MS=120000
SOCIAL_DOWNLOAD_TMP_DIR=/tmp/chat-pack-social-downloads

# Alertas de monitoreo de WhatsApp via ntfy
# NTFY_TOPIC habilita las notificaciones; si queda vacio, se omiten.
# NTFY_BASE_URL es opcional y por defecto usa https://ntfy.sh.
NTFY_BASE_URL=https://ntfy.sh
# Ejemplo: NTFY_TOPIC=tu_topic_de_alertas_dev
NTFY_TOPIC=

# Ejemplo con LocalAuth
WHATSAPP_AUTH_MODE=local
WHATSAPP_CLIENT_ID=cliente

# Ejemplo con RemoteAuth
# WHATSAPP_AUTH_MODE=remote
# WHATSAPP_CLIENT_ID=cliente
# MONGODB_URI=mongodb://mongo:mongo@localhost:27017/
# WHATSAPP_REMOTE_BACKUP_SYNC_INTERVAL_MS=60000
